/**
 * Generates the icon sprite and the list of valid icon names.
 * Reads the SVG files in assets/icons/lucide (one per icon) and produces:
 * - dist/web/assets/icons.svg: sprite with one <symbol> per icon;
 * - src/framework/ts/icons/icon-names.ts: icon names as a TypeScript type.
 */

import fs from 'node:fs';
import path from 'node:path';

const appDir = path.join(import.meta.dirname, '..');
const sourceDir = path.join(appDir, 'assets', 'icons', 'lucide');
const spriteFile = path.join(appDir, 'dist', 'web', 'assets', 'icons.svg');
const namesFile = path.join(appDir, 'src', 'framework', 'ts', 'icons', 'icon-names.ts');

const VIEW_BOX = '0 0 24 24';
const NAME_PATTERN = /^[a-z0-9]+(-[a-z0-9]+)*$/;

/**
 * Extracts the inner content of a Lucide SVG file, checking its format.
 */
function readIconBody(file: string): string {
    const source = fs.readFileSync(file, 'utf8').replace(/<!--[\s\S]*?-->/g, '');
    const match = /<svg([^>]*)>([\s\S]*)<\/svg>/.exec(source);

    if (match === null) {
        throw new Error(`Invalid SVG file: ${file}`);
    }
    if (!match[1].includes(`viewBox="${VIEW_BOX}"`)) {
        throw new Error(`viewBox different from "${VIEW_BOX}": ${file}`);
    }

    return match[2]
        .split('\n')
        .map((line) => line.trim())
        .filter((line) => line !== '')
        .join('');
}

const names = fs.readdirSync(sourceDir)
    .filter((file) => file.endsWith('.svg'))
    .map((file) => file.slice(0, -'.svg'.length))
    .sort();

for (const name of names) {
    if (!NAME_PATTERN.test(name)) {
        throw new Error(`Invalid icon name: ${name}`);
    }
}

const symbols = names.map((name) => {
    const body = readIconBody(path.join(sourceDir, `${name}.svg`));
    return `<symbol id="${name}" viewBox="${VIEW_BOX}">${body}</symbol>`;
});

const sprite = [
    '<svg xmlns="http://www.w3.org/2000/svg">',
    '<!-- Lucide icons, ISC license: https://lucide.dev -->',
    ...symbols,
    '</svg>',
    ''
].join('\n');

const namesSource = [
    '/**',
    ' * File generated by scripts/build-icons.mts: do not edit by hand.',
    ' * List of the icons available in assets/icons/lucide.',
    ' */',
    '',
    'export const ICON_NAMES = [',
    names.map((name) => `    '${name}'`).join(',\n'),
    '] as const;',
    '',
    '/** Name of an available icon */',
    'export type IconName = typeof ICON_NAMES[number];',
    ''
].join('\n');

fs.mkdirSync(path.dirname(spriteFile), { recursive: true });
fs.writeFileSync(spriteFile, sprite);
fs.writeFileSync(namesFile, namesSource);
